{
  "manifest_version": 3,
  "name": "玄镜 AegisScope",
  "version": "1.0.0",
  "version_name": "V1.0.0",
  "description": "前端代码资产采集、泄露扫描、漏洞审计与 Vue Router 运行时分析工具。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "玄镜 AegisScope V1.0.0",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
